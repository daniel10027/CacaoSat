# Copier vers .env pour le développement local
FLASK_APP=wsgi.py
FLASK_CONFIG=development
FLASK_DEBUG=1

SECRET_KEY=dev-secret-change-me
JWT_SECRET_KEY=dev-jwt-secret-change-me

DATABASE_URL=postgresql+psycopg://cacaosat:cacaosat@localhost:5432/cacaosat
TEST_DATABASE_URL=postgresql+psycopg://cacaosat:cacaosat@localhost:5432/cacaosat_test
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_DEFAULT_SENDER=no-reply@cacaosat.ci

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cacaosat
S3_REGION=us-east-1

MOCK_SEED=42
SEED_ON_START=0
LOG_LEVEL=INFO

# Fond de carte du PDF de conformité (tuiles raster Web Mercator).
# Mettre REPORT_BASEMAP_ENABLED=0 pour un déploiement sans accès sortant :
# le rapport se génère alors avec le rendu vectoriel seul.
REPORT_BASEMAP_ENABLED=1
REPORT_BASEMAP_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
REPORT_BASEMAP_ATTRIBUTION=Fond : Esri World Imagery — Esri, Maxar, Earthstar Geographics
REPORT_BASEMAP_TIMEOUT=6
REPORT_BASEMAP_BUDGET=20
REPORT_BASEMAP_CACHE_DIR=
