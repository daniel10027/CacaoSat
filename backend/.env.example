# Copier vers .env pour le développement local
FLASK_APP=wsgi.py
FLASK_CONFIG=development
FLASK_DEBUG=1

SECRET_KEY=dev-secret-change-me
JWT_SECRET_KEY=dev-jwt-secret-change-me

DATABASE_URL=postgresql+psycopg://cacaosat:cacaosat@localhost:5432/cacaosat
TEST_DATABASE_URL=postgresql+psycopg://cacaosat:cacaosat@localhost:5432/cacaosat_test
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_DEFAULT_SENDER=no-reply@cacaosat.ci

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cacaosat
S3_REGION=us-east-1

MOCK_SEED=42
SEED_ON_START=0
LOG_LEVEL=INFO
